USER_NAME=your_name
OLLAMA_HOST=http://127.0.0.1:11434
ARVIS_MODEL=arvis

# Standalone MCP Context Servant (реальні корені зберігай в ignored .env/.env.local):
# ARVIS_MCP_PROFILE=codex
# ARVIS_MCP_PROJECT_ROOT=/path/to/arvis
# ARVIS_MCP_ALLOWED_ROOTS=/path/to/arvis
# ARVIS_SYSTEM_METRICS_STORAGE_PATH=/path/to/filesystem
# ARVIS_DOTNET_PATH=/path/to/dotnet
# ARVIS_STARDEW_GAME_PATH=/path/to/stardew-valley
# ARVIS_SMAPI_LOG_PATH=/path/to/SMAPI-latest.txt
# ARVIS_CODEX_AGENT_CONTROL_ENABLED=false
# ARVIS_CODEX_AGENT_STATE_ROOT=/path/outside/project-roots/agent-state

MUSIC_FOLDER=/path/to/music
DOWNLOADS_FOLDER=/path/to/downloads

STEAM_COMMAND=steam
SPOTIFY_COMMAND=flatpak run com.spotify.Client
BRAVE_COMMAND=brave-browser
DISCORD_COMMAND=flatpak run com.discordapp.Discord
TELEGRAM_COMMAND=flatpak run org.telegram.desktop
YOUTUBE_COMMAND=xdg-open https://www.youtube.com/
GOOGLE_COMMAND=xdg-open https://www.google.com/
GITHUB_COMMAND=xdg-open https://github.com/
CHATGPT_COMMAND=xdg-open https://chatgpt.com/

# Приклади для браузера Brave:
# YOUTUBE_COMMAND=brave-browser https://www.youtube.com/
# GOOGLE_COMMAND=brave-browser https://www.google.com/
# GITHUB_COMMAND=brave-browser https://github.com/
# CHATGPT_COMMAND=brave-browser https://chatgpt.com/
#
# Приклад Brave через Flatpak:
# YOUTUBE_COMMAND=flatpak run com.brave.Browser https://www.youtube.com/

ARVIS_BROWSER_DEBUG_SAVE=false
ARVIS_BROWSER_OBSERVER_HEADFUL=false

ARVIS_VOICE_ENABLED=false
ARVIS_STT_BACKEND=faster_whisper
ARVIS_STT_MODEL=small
ARVIS_STT_DEVICE=auto
ARVIS_STT_COMPUTE_TYPE=auto
ARVIS_MIC_DEVICE=
ARVIS_VOICE_RECORD_SECONDS=6
ARVIS_VOICE_LANGUAGE=uk
ARVIS_VOICE_ALLOWED_LANGUAGES=uk,ru,en,no
ARVIS_VOICE_MIN_RMS=0.008
ARVIS_VOICE_MIN_PEAK=0.03
ARVIS_VOICE_DEBUG_SAVE_LAST=false
ARVIS_VOICE_DUCKING_ENABLED=true
ARVIS_VOICE_DUCK_PERCENT=15
ARVIS_VOICE_DUCK_RESTORE=true

MINECRAFT_SERVER_ENABLED=false
MINECRAFT_SERVER_KEY=default
MINECRAFT_SERVER_NAME=My Minecraft Server
MINECRAFT_SERVER_CWD=/absolute/path/to/server
MINECRAFT_SERVER_COMMAND=./start.sh
